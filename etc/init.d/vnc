#!/sbin/openrc-run
# Copyright 1999-2014 Gentoo Foundation
# Distributed under the terms of the GNU General Public License, v2 or later
#
# Starts tcpulse, the X session and its x11vnc. One script, no daemon.
#
# There is deliberately NO supervision loop here any more. An earlier version
# kept a long-running shell (supervise(), previously /usr/local/bin/vnc-session-
# guard) polling every 5s to restart X and x11vnc. That had two costs:
#
#   1. A long-running shell holds the script's function definitions in memory
#      as they were when it started, so editing this file changed nothing until
#      that process was restarted - flag changes appeared to be ignored.
#   2. Two launchers both managing x11vnc meant several copies could run; the
#      losers could not bind the rfb port, died with BadShmSeg, and were
#      restarted by x11vnc's own -loop ~24 times a minute.
#
# Trade-off to be aware of: .xinitrc ends in a `while pgrep dwm; sleep 1; done`
# loop, so the X server's lifetime is tied to the window manager. With nothing
# supervising, a dead dwm - or anything that kills the startx/xinit tree - ends
# the session and it stays down until someone runs `rc-service vnc start`.
#
# Every function below is idempotent: start() only starts what is not already
# running, so it is safe to re-run against a live session to pick up changes to
# this file (e.g. to restart just x11vnc after editing its flags).

DISPLAYS="1000:2"

depend() {
	need net
}

# Run $1 as user $2.
as_user() {
	su -s /bin/bash "$2" -c "$1"
}

x_alive() {
	# $1 = display number
	[ -S "/tmp/.X11-unix/X$1" ] || return 1
	ps -eo comm=,args= | awk -v d=":$1" '
		($1=="X"||$1=="Xorg") && index($0,d) {found=1}
		END {exit !found}'
}

vnc_alive() {
	# $1 = display number
	ps -eo comm=,args= | awk -v d="-display :$1" '
		$1=="x11vnc" && index($0,d) {found=1}
		END {exit !found}'
}

tcpulse_alive() {
	# $1 = display number
	ps -eo comm=,args= | awk -v p="570$1" '
		$1=="tcpulse" && index($0,p) {found=1}
		END {exit !found}'
}

start_x() {
	# $1 = display number, $2 = user
	einfo "starting X on :$1"
	rm -f "/tmp/.X$1-lock" 2>/dev/null
	as_user "cd ~ && exec startx -- :$1" "$2" >>"/var/log/x11.$2.log" 2>&1 &
	for _ in $(seq 1 30); do
		sleep 1
		x_alive "$1" && return 0
	done
	eerror "X on :$1 failed to come up within 30s"
	return 1
}

start_vnc() {
	# $1 = display number, $2 = user
	#
	# -nevershared: "never treat new clients as shared", so a new connection
	# disconnects whoever was there. With the previous -alwaysshared, existing
	# clients were never dropped and a stale session kept holding the display,
	# so a newly opened one could not get in. noVNC sends shared=1 itself
	# (rfb.js ClientInitialisation), so the server has to override it. Do NOT
	# add -dontdisconnect: that refuses the *new* connection instead.
	#
	# -wait 5 -defer 5 (defaults are 20/20): -wait is the framebuffer poll
	# interval, -defer the delay before sending an update, so the defaults add
	# up to ~40ms before a change reaches the client. Measured draw-to-client
	# latency here: median ~26-33ms -> ~6ms, p90 ~56ms -> ~9ms, for 9% -> 12%
	# of a core under continuous redraw. The server idles near 2%.
	#
	# -xrandr: without it x11vnc assumes the screen never changes size and,
	# in its own words responds to an XRANDR event by "simply crashing by
	# assuming the old screen size". Any resolution change would take it
	# down, including the one the Xorg config now makes at session start.
	#
	# LD_PRELOAD of zlib-ng: Tight and ZRLE both drive zlib. zlib-ng emits
	# ~11.5% smaller Tight frames for the same screen (11,138 -> 9,858 bytes on
	# one identical frame; ZRLE unchanged), CPU a wash. Preloaded for x11vnc
	# alone rather than installed over the system libz. Drop it to revert.
	einfo "starting x11vnc for :$1 on port 580$1"
	as_user "source /etc/profile; /bin/shm_clear -y >/dev/null 2>&1; \
		export UNIXPW_DISABLE_SSL=1 UNIXPW_DISABLE_LOCALHOST=1 FD_GEOM=1600x900; \
		export LD_PRELOAD=/usr/local/lib/zlib-ng/libz.so.1; \
		cd ~ && exec x11vnc -threads -forever -nevershared -nomodtweak -noxkb \
		  -wait 5 -defer 5 -xrandr \
		  -rfbport 580$1 -nopw -loop -display :$1 \
		  -ssl /etc/cert.pem -sslverify /etc/vnc-ca/ca.crt \
		  -repeat -clear_all -skip_lockkeys -auth /home/$2/.Xauthority" "$2" \
		>>"/var/log/vncserver.$1.log" 2>&1 &
	sleep 3
}

start_tcpulse() {
	# $1 = display number, $2 = user
	einfo "starting tcpulse on port 570$1"
	as_user "TCPULSE_CLIENT_CA=/etc/vnc-ca/ca.crt /bin/tcpulse /etc/cert.pem 570$1" "$2" \
		>"/var/log/tcpulse.$2.log" 2>&1 &
}

start() {
	ebegin "Starting VNC server"

	for user in $DISPLAYS; do
		usrid=${user%%:*}
		usrname=$(id -u -n "$usrid")
		usrdisp=${user##*:}

		# Idempotent: only start what is not already up, so re-running this
		# against a live session picks up flag changes without touching X.
		tcpulse_alive "$usrdisp" || start_tcpulse "$usrdisp" "$usrname"

		if x_alive "$usrdisp"; then
			einfo "X on :$usrdisp already running"
		else
			start_x "$usrdisp" "$usrname" || continue
		fi

		if vnc_alive "$usrdisp"; then
			einfo "x11vnc for :$usrdisp already running"
		else
			start_vnc "$usrdisp" "$usrname"
		fi
	done

	eend 0
}

stop() {
	ebegin "Stopping VNC server"

	for user in $DISPLAYS; do
		usrid=${user%%:*}
		usrdisp=${user##*:}
		# Do not pkill -U $usrid: that kills every process the user owns,
		# including unrelated login shells. Stop only this display's stack.
		pkill -U "$usrid" -f "x11vnc .*-display :$usrdisp"
		pkill -U "$usrid" -f "^xinit .*:$usrdisp"
		pkill -U "$usrid" -f "^/usr/bin/X .*:$usrdisp"
		rm -rf "/tmp/.X$usrdisp-lock" 2>/dev/null
	done

	rm -rf /tmp/.X11-unix >/dev/null 2>&1

	eend 0
}

# Restart only x11vnc, leaving X and every application in the session running.
# This is the safe way to apply changes to start_vnc()'s flags.
restart_vnc() {
	ebegin "Restarting x11vnc only"
	for user in $DISPLAYS; do
		usrid=${user%%:*}
		usrname=$(id -u -n "$usrid")
		usrdisp=${user##*:}
		pkill -U "$usrid" -f "x11vnc .*-display :$usrdisp"
		sleep 2
		start_vnc "$usrdisp" "$usrname"
	done
	eend 0
}

extra_commands="restart_vnc"

restart() {
	svc_stop
	svc_start
}
