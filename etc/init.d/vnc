DISPLAYS="1000:2"

depend() {
	need net
}


runx(){
   while true; do
        pgrep x11vnc | xargs kill -9 >/dev/null 2>&1
        for user in "$DISPLAYS"; do
            usrid=${user%%:*}
            usrname=$( id -u -n $usrid )
            usrdisp=${user##*:}
            su -s /bin/bash ${usrname} -c "/bin/shm_clear -y"
            su -s /bin/bash ${usrname} -c "source /etc/profile && export UNIXPW_DISABLE_SSL=1 && export UNIXPW_DISABLE_LOCALHOST=1 && cd ~$usrname && export FD_GEOM=1920x1080 && x11vnc -threads -forever -nevershared -nomodtweak -noxkb  -rfbport 580${usrdisp} -nopw -loop -display \":$usrdisp\" -ssl /etc/cert.pem -sslverify /etc/vnc-ca/ca.crt -repeat -clear_all -skip_lockkeys -auth /home/$usrname/.Xauthority " >/var/log/vncserver.${usrdisp}.log 2>&1 &
        done
        sleep 72000
    done
}

start() {
	ebegin "Starting VNC server"

	for user in "$DISPLAYS"; do
		usrid=${user%%:*}
                usrname=$( id -u -n $usrid )
		usrdisp=${user##*:}
                su -s "/bin/bash" $usrname -c "startx -- :$usrdisp" > /var/log/x11.$usrname.log 2>&1 &
                su -s "/bin/bash" $usrname -c "TCPULSE_CLIENT_CA=/etc/vnc-ca/ca.crt /bin/tcpulse /etc/cert.pem 570${usrdisp}" > /var/log/tcpulse.$usrname.log 2>&1 &
	done

        runx &
	eend $?
}

stop() {
	ebegin "Stopping VNC server"
#        pkill -U 1000
        pgrep x11vnc | xargs kill -9 >/dev/null 2>&1

	for user in $DISPLAYS; do
                usrid=${user%%:*}
                usrdisp=${user##*:}
                pkill -U $usrid
                rm -rf /tmp/.X$usrdisp-lock 2>/dev/null
 	done

        rm -rf /tmp/.X11-unix >/dev/null 2>&1

 	eend 0
}

restart() {
        svc_stop
        svc_start
}
