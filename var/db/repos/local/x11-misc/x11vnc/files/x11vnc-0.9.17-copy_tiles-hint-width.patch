 #include "macosx.h"
 #include "userinput.h"
 
+/*
+ * Byte-granular difference scanning helpers used by copy_tiles().
+ *
+ * Both return the index of the first (resp. last) differing byte in [0,n),
+ * or -1 if the ranges are equal.  Neither ever reads outside [0,n): the
+ * 16-byte SSE2 step is guarded by i+16<=n and the 8-byte step by i+8<=n,
+ * with a byte-wise remainder.  SSE2 is unconditionally available on x86_64
+ * and is used when the compiler advertises it; otherwise the portable
+ * 64-bit word path is used, which is still far faster than a per-pixel
+ * memcmp() call (memcmp() with a run-time length is never inlined).
+ */
+#if defined(__SSE2__)
+#include <emmintrin.h>
+#endif
+
+static int first_diff_byte(const char *a, const char *b, int n) {
+	int i = 0;
+#if defined(__SSE2__)
+	for (; i + 16 <= n; i += 16) {
+		__m128i va = _mm_loadu_si128((const __m128i *)(a + i));
+		__m128i vb = _mm_loadu_si128((const __m128i *)(b + i));
+		unsigned m = (unsigned) _mm_movemask_epi8(_mm_cmpeq_epi8(va, vb)) ^ 0xFFFFu;
+		if (m) return i + __builtin_ctz(m);
+	}
+#endif
+	for (; i + 8 <= n; i += 8) {
+		uint64_t x, y;
+		memcpy(&x, a + i, 8);
+		memcpy(&y, b + i, 8);
+		if (x != y) {
+			uint64_t d = x ^ y;
+#if __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
+			return i + (int)(__builtin_ctzll(d) >> 3);
+#else
+			return i + (int)(__builtin_clzll(d) >> 3);
+#endif
+		}
+	}
+	for (; i < n; i++) {
+		if (a[i] != b[i]) return i;
+	}
+	return -1;
+}
+
+static int last_diff_byte(const char *a, const char *b, int n) {
+	int i = n;
+#if defined(__SSE2__)
+	for (; i - 16 >= 0; i -= 16) {
+		__m128i va = _mm_loadu_si128((const __m128i *)(a + i - 16));
+		__m128i vb = _mm_loadu_si128((const __m128i *)(b + i - 16));
+		unsigned m = (unsigned) _mm_movemask_epi8(_mm_cmpeq_epi8(va, vb)) ^ 0xFFFFu;
+		if (m) return i - 16 + (31 - __builtin_clz(m));
+	}
+#endif
+	for (; i - 8 >= 0; i -= 8) {
+		uint64_t x, y;
+		memcpy(&x, a + i - 8, 8);
+		memcpy(&y, b + i - 8, 8);
+		if (x != y) {
+			uint64_t d = x ^ y;
+#if __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
+			return i - 8 + 7 - (int)(__builtin_clzll(d) >> 3);
+#else
+			return i - 8 + 7 - (int)(__builtin_ctzll(d) >> 3);
+#endif
+		}
+	}
+	for (; i > 0; i--) {
+		if (a[i-1] != b[i-1]) return i-1;
+	}
+	return -1;
+}
+
 /*
  * routines for scanning and reading the X11 display for changes, and
  * for doing all the tile work (shm, etc).
@@ -2016,34 +2089,50 @@ static int copy_tiles(int tx, int ty, int nt) {
